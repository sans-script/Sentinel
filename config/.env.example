# Sentinel settings. Copy this file to config/.env (it is ignored by git).

# Address the dashboard listens on. Anything other than 127.0.0.1 requires SENTINEL_API_TOKEN.
SERVER_HOST=127.0.0.1

# Dashboard port
SENTINEL_PORT=8000

# Access token for the dashboard and API (sent as "Authorization: Bearer <token>", ?token= or a cookie).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SENTINEL_API_TOKEN=

# Origins allowed by CORS, comma separated. Empty means same origin only.
# ALLOWED_ORIGINS=

# Verify TLS certificates in the HTTP checks (true / false)
VERIFY_SSL=true

# Seconds between monitoring cycles
INTERVAL_SECONDS=60

# Simultaneous SSH connections (3 to 8 is reasonable)
MAX_SSH_WORKERS=3

# SSH timeout in seconds
SSH_TIMEOUT=10

# Default SSH user, used when a target does not set "user"
SSH_USER=monitor

# Unknown SSH hosts: "strict" refuses them (default), "accept-new" trusts a host on first contact.
SSH_HOST_KEY_POLICY=strict

# Extra known_hosts file, in addition to the system one (optional)
# SSH_KNOWN_HOSTS=

# SSH private key, pick ONE of the options. Never commit the real value.
# Option 1: a single line with \n escapes
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# Option 2: the key encoded in base64
# SSH_KEY_BASE64=

# Serve made-up telemetry for config/sites.demo.json (screenshots, trying the dashboard)
# SENTINEL_DEMO=1
